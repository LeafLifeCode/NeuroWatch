# Mock responses are enabled by default. Set to false when the backend is ready.
VITE_USE_MOCK_SPEECH=true
# Backward-compatible alias for existing local setups.
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://127.0.0.1:8000
# Automatically use a mock recording when permission or MediaRecorder is unavailable.
VITE_USE_MOCK_RECORDING_FALLBACK=true
